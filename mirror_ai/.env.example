# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"polmirap-25a9a",...}

# Behavior
AUTONOMY_MODE=controlled
VETO_WINDOW_HOURS=2
STOP_LOSS_PCT=15
MAX_POSITION_PCT=7
SECTOR_CAP_PCT=20

ALPACA_SECRET=your_alpaca_secret
ALPACA_PAPER=true

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Gemini AI (Google I/O 2026)
GEMINI_API_KEY=your_gemini_api_key

# Brave Search
